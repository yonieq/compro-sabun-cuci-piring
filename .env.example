# ---------------------------------------------------------------------------
# CITRAVA — environment configuration
# Copy this file to `.env.local` and adjust the values for your environment.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# Canonical site origin. Used for metadata, canonicals, OG URLs, sitemap and
# robots.txt. Must include the protocol and no trailing slash.
# Local default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact form delivery (NOT configured in the prototype)
# ---------------------------------------------------------------------------
# The contact form validates submissions in the browser and in the API route,
# and the route currently acknowledges without sending mail. To enable real
# delivery, implement the marked integration block in
# `src/app/api/contact/route.ts` and set the values below.

# Destination inbox for contact submissions.
CONTACT_TO_EMAIL=

# Verified sender address for the email provider (e.g. no-reply@yourdomain.com).
CONTACT_FROM_EMAIL=

# Provider identifier understood by your integration (e.g. "resend", "ses").
CONTACT_EMAIL_PROVIDER=

# Provider API key. Server-side only — never expose with NEXT_PUBLIC_.
CONTACT_EMAIL_API_KEY=
